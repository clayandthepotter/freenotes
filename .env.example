# Copy to .env and `source` it, or export in your shell. Nothing here is required.
ANTHROPIC_API_KEY=
FREENOTES_AI=auto            # auto | claude | heuristic
FREENOTES_MODEL=claude-opus-5-5
FREENOTES_EFFORT=high        # low | medium | high | xhigh | max
FREENOTES_PROFILE=           # e.g. "Head of product; mornings are for deep work"
PORT=8787

# Accounts (optional). With all three set, sign-in and synced settings are enabled.
SUPABASE_URL=                # https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=    # sb_publishable_… (RLS applies; no service-role key needed)
FREENOTES_KEY_SECRET=        # openssl rand -base64 32 — encrypts users' provider API keys at rest
# The web app needs the same two Supabase values at build time:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
