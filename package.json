{
  "name": "freenotes",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source notes with an AI chief of staff: braindump → time-blocked schedule → execution plans → achievement report → reflection.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
